<Window x:Class="AutoUpdaterTestWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoUpdaterTestWPF"
        mc:Ignorable="d"
        Title="AutoUpdaterTestWPF" Height="150" Width="250" ResizeMode="CanResizeWithGrip">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Label x:Name="LabelVersion" Content="Current Version : 1.0.0.0" Margin="0" Width="170"/>
        <Button x:Name="ButtonCheckForUpdate" Content="Check for Update" Margin="0, 10" Width="170"  Height="29" Click="ButtonCheckForUpdate_Click"/>
        <Button x:Name="ButtonExtractZip" Content="Extract Zip" Margin="0, 10" Width="170"  Height="29" Click="ButtonExtractZip_Click"/>
    </StackPanel>
</Window>
